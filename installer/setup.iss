; ============================================================================
;  VoidRemove - Inno Setup script
;  Builds VoidRemove-Setup.exe from the published single-file executables.
;  Identity (name/version/urls) is read from appinfo.ini, which is generated by
;  tools/sync_appinfo.py from AppInfo.cs, so one edit renames everything.
; ============================================================================

#ifndef AppName
  #define AppName      ReadIni(SourcePath + "\appinfo.ini", "App", "Name", "VoidRemove")
#endif
#ifndef AppId
  #define AppId        ReadIni(SourcePath + "\appinfo.ini", "App", "Id", "VoidRemove")
#endif
#ifndef AppVersion
  #define AppVersion   ReadIni(SourcePath + "\appinfo.ini", "Version", "VersionPrefix", "0.1.0")
#endif
#define RepoUrl        ReadIni(SourcePath + "\appinfo.ini", "App", "RepositoryUrl", "https://github.com/yswef/VoidRemove")
#define IssuesUrl      ReadIni(SourcePath + "\appinfo.ini", "App", "IssuesUrl", "https://github.com/yswef/VoidRemove/issues")

[Setup]
AppId={#AppId}
AppName={#AppName}
AppVersion={#AppVersion}
AppVerName={#AppName} {#AppVersion}
AppPublisher={#AppName} Project
AppPublisherURL={#RepoUrl}
AppSupportURL={#IssuesUrl}
AppUpdatesURL={#RepoUrl}/releases
VersionInfoVersion={#AppVersion}.0
DefaultDirName={pf}\{#AppName}
DefaultGroupName={#AppName}
PrivilegesRequired=admin
ArchitecturesAllowed=x64 arm64
ArchitecturesInstallIn64BitMode=x64 arm64
OutputDir=..\publish\installer
OutputBaseFilename={#AppName}-Setup
SetupIconFile=..\assets\icon.ico
UninstallDisplayIcon={app}\VoidRemove.Wpf.exe
UninstallDisplayName={#AppName}
WizardStyle=modern
WizardImageFile=..\assets\setup-wizard.bmp
WizardSmallImageFile=..\assets\setup-header.bmp
LicenseFile=..\LICENSE
DisableProgramGroupPage=yes
Compression=lzma2/ultra64
SolidCompression=yes
ShowLanguageDialog=yes
Uninstallable=yes
CreateUninstallRegKey=yes

[Languages]
Name: "en";  MessagesFile: "compiler:Default.isl"
Name: "ar";  MessagesFile: "compiler:Languages\Arabic.isl"

[CustomMessages]
en.WpfTitle=Classic interface (WPF) - recommended
ar.WpfTitle=الواجهة الكلاسيكية (WPF) - مستحسن
en.WinUITitle=Modern interface (WinUI 3, Windows 10/11)
ar.WinUITitle=الواجهة الحديثة (WinUI 3، ويندوز 10/11)
en.DesktopIcon=Create a &desktop shortcut
ar.DesktopIcon=إنشاء اختصار على سطح ال&مكتب
en.LaunchNow=Launch {#AppName} now
ar.LaunchNow=تشغيل {#AppName} الآن

[Types]
Name: "full";  Description: "Full installation"
Name: "wpfonly"; Description: "WPF only"

[Components]
Name: "wpf";    Description: "{cm:WpfTitle}";  Types: full wpfonly; Flags: default
Name: "winui";  Description: "{cm:WinUITitle}"; Types: full

[Tasks]
Name: "desktopicon"; Description: "{cm:DesktopIcon}"; GroupDescription: "{cm:AdditionalIcons}"

[Files]
; Published single-file executables (produced by the release workflow).
Source: "..\publish\wpf\VoidRemove-Wpf-x64.exe";     DestDir: "{app}"; DestName: "VoidRemove.Wpf.exe";   Components: wpf;   Flags: ignoreversion
Source: "..\publish\winui\VoidRemove-WinUI-x64.exe"; DestDir: "{app}"; DestName: "VoidRemove.WinUI.exe"; Components: winui; Flags: ignoreversion
; Editable data ships with the app and is never overwritten on upgrade.
Source: "..\data\*"; DestDir: "{app}\data"; Flags: recursesubdirs createallsubdirs uninsneveruninstall

[Icons]
Name: "{group}\{#AppName}";            Filename: "{app}\VoidRemove.Wpf.exe";  Components: wpf
Name: "{group}\{#AppName} (WinUI)";    Filename: "{app}\VoidRemove.WinUI.exe"; Components: winui
Name: "{group}\{cm:UninstallProgram,{#AppName}}"; Filename: "{uninstallexe}"
Name: "{commondesktop}\{#AppName}";    Filename: "{app}\VoidRemove.Wpf.exe";  Components: wpf;   Tasks: desktopicon
Name: "{commondesktop}\{#AppName}";    Filename: "{app}\VoidRemove.WinUI.exe"; Components: winui not wpf; Tasks: desktopicon

[Run]
Filename: "{app}\VoidRemove.Wpf.exe";   Description: "{cm:LaunchNow}"; Flags: nowait postinstall skipifsilent runascurrentuser; Components: wpf
Filename: "{app}\VoidRemove.WinUI.exe"; Description: "{cm:LaunchNow}"; Flags: nowait postinstall skipifsilent runascurrentuser; Components: winui not wpf

[UninstallDelete]
Type: filesandordirs; Name: "{app}\data"
Type: filesandordirs; Name: "{group}"

[Code]
// Cleans the registry footprint and the Explorer context-menu verbs on uninstall.
procedure CurUninstallStepChanged(CurUninstallStep: TUninstallStep);
begin
  if CurUninstallStep = usPostUninstall then
  begin
    // VoidRemove's own settings key.
    RegDeleteKeyIncludingSubkeys(HKEY_LOCAL_MACHINE, 'Software\{#AppId}');
    // Explorer context-menu verbs written by ExplorerContextMenuService.
    RegDeleteKeyIncludingSubkeys(HKEY_CLASSES_ROOT, '.exe\shell\{#AppId}.Uninstall');
    RegDeleteKeyIncludingSubkeys(HKEY_CLASSES_ROOT, '.exe\shell\{#AppId}.ResetApp');
    RegDeleteKeyIncludingSubkeys(HKEY_CLASSES_ROOT, '.lnk\shell\{#AppId}.Uninstall');
    RegDeleteKeyIncludingSubkeys(HKEY_CLASSES_ROOT, '.lnk\shell\{#AppId}.ResetApp');
    RegDeleteKeyIncludingSubkeys(HKEY_CLASSES_ROOT, '.msi\shell\{#AppId}.Uninstall');
    RegDeleteKeyIncludingSubkeys(HKEY_CLASSES_ROOT, '.msi\shell\{#AppId}.ResetApp');
  end;
end;
