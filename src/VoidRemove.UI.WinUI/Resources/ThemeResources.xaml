<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--
    Default palette (the Dark theme) plus the text styles shared by every page.
    WinUIThemeApplier overwrites the brushes at startup and on every theme change.
  -->

  <SolidColorBrush x:Key="Brush.Window" Color="#0B0E14" />
  <SolidColorBrush x:Key="Brush.Sidebar" Color="#090C11" />
  <SolidColorBrush x:Key="Brush.TitleBar" Color="#0B0E14" />
  <SolidColorBrush x:Key="Brush.Card" Color="#121722" />
  <SolidColorBrush x:Key="Brush.Elevated" Color="#171D2A" />
  <SolidColorBrush x:Key="Brush.Input" Color="#0F1420" />
  <SolidColorBrush x:Key="Brush.ControlHover" Color="#1A3239" />
  <SolidColorBrush x:Key="Brush.ControlPressed" Color="#1C4346" />
  <SolidColorBrush x:Key="Brush.Selection" Color="#222EE6A8" />
  <SolidColorBrush x:Key="Brush.Border" Color="#232B3B" />
  <SolidColorBrush x:Key="Brush.Divider" Color="#1A2130" />
  <SolidColorBrush x:Key="Brush.Text" Color="#E8ECF4" />
  <SolidColorBrush x:Key="Brush.TextSecondary" Color="#98A2B8" />
  <SolidColorBrush x:Key="Brush.TextDisabled" Color="#5B6478" />
  <SolidColorBrush x:Key="Brush.Accent" Color="#2EE6A8" />
  <SolidColorBrush x:Key="Brush.AccentHover" Color="#5CEBBC" />
  <SolidColorBrush x:Key="Brush.AccentPressed" Color="#25BF8C" />
  <SolidColorBrush x:Key="Brush.AccentForeground" Color="#06120D" />
  <SolidColorBrush x:Key="Brush.Success" Color="#35D07F" />
  <SolidColorBrush x:Key="Brush.Warning" Color="#F5B840" />
  <SolidColorBrush x:Key="Brush.Danger" Color="#FF5470" />
  <SolidColorBrush x:Key="Brush.Info" Color="#4CC2FF" />
  <SolidColorBrush x:Key="Brush.Overlay" Color="#8C000000" />

  <x:Double x:Key="Metric.SidebarWidth">236</x:Double>
  <x:Double x:Key="Metric.TitleBarHeight">40</x:Double>
  <CornerRadius x:Key="CornerRadius.Card">10</CornerRadius>
  <CornerRadius x:Key="CornerRadius.Control">8</CornerRadius>

  <Style x:Key="Text.Base" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
    <Setter Property="FontSize" Value="13.5" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>

  <Style x:Key="Text.Title" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
    <Setter Property="FontSize" Value="22" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Margin" Value="0,0,0,4" />
  </Style>

  <Style x:Key="Text.SectionHeader" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
    <Setter Property="FontSize" Value="17" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Margin" Value="0,0,0,12" />
  </Style>

  <Style x:Key="Text.Label" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
    <Setter Property="Foreground" Value="{StaticResource Brush.TextSecondary}" />
    <Setter Property="FontSize" Value="12" />
  </Style>

  <Style x:Key="Text.Hint" TargetType="TextBlock" BasedOn="{StaticResource Text.Label}">
    <Setter Property="Margin" Value="0,4,0,0" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <Style x:Key="Text.Value" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style x:Key="Card" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource Brush.Card}" />
    <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource CornerRadius.Card}" />
    <Setter Property="Padding" Value="18" />
    <Setter Property="Margin" Value="0,0,0,14" />
  </Style>

  <Style x:Key="Nav.ListView" TargetType="ListView">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="SelectionMode" Value="Single" />
    <Setter Property="IsItemClickEnabled" Value="False" />
  </Style>

</ResourceDictionary>
