<Window x:Class="VoidRemove.UI.WinUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:conv="using:VoidRemove.UI.WinUI.Converters"
        mc:Ignorable="d">

  <Grid x:Name="RootGrid" Background="{StaticResource Brush.Window}" FlowDirection="LeftToRight">

    <Grid.Resources>
      <conv:NavGlyphConverter x:Key="NavGlyph" />
    </Grid.Resources>

    <Grid.RowDefinitions>
      <RowDefinition Height="40" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- Title bar. Handed to SetTitleBar so Windows draws the caption buttons. -->
    <Grid x:Name="AppTitleBar" Grid.Row="0" Background="{StaticResource Brush.TitleBar}">
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
        <Image Source="ms-appx:///Assets/icon-256.png" Width="16" Height="16" VerticalAlignment="Center" />
        <TextBlock Text="{Binding Shell.ProductName}"
                   Foreground="{StaticResource Brush.Text}"
                   FontSize="12.5"
                   FontWeight="SemiBold"
                   Margin="9,0,0,0"
                   VerticalAlignment="Center" />
        <TextBlock Text="{Binding Shell.VersionText}"
                   Foreground="{StaticResource Brush.TextDisabled}"
                   FontSize="11"
                   Margin="9,0,0,0"
                   VerticalAlignment="Center" />
      </StackPanel>
    </Grid>

    <!-- Body -->
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <Border x:Name="SidebarPanel"
              Grid.Column="0"
              Width="{StaticResource Metric.SidebarWidth}"
              Background="{StaticResource Brush.Sidebar}"
              BorderBrush="{StaticResource Brush.Divider}"
              BorderThickness="0,0,1,0">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <StackPanel Grid.Row="0" Margin="20,18,20,10">
            <TextBlock Text="{Binding Shell.ProductName}"
                       Foreground="{StaticResource Brush.Text}"
                       FontSize="16"
                       FontWeight="SemiBold" />
            <TextBlock Text="{Binding Shell.Tagline}"
                       Foreground="{StaticResource Brush.TextSecondary}"
                       FontSize="11"
                       TextWrapping="Wrap"
                       Margin="0,6,0,0" />
          </StackPanel>

          <ListView x:Name="NavList"
                    Grid.Row="1"
                    Style="{StaticResource Nav.ListView}"
                    ItemsSource="{Binding Shell.Items}"
                    SelectionChanged="OnNavSelectionChanged">
            <ListView.ItemTemplate>
              <DataTemplate>
                <StackPanel Orientation="Horizontal" Padding="4,9">
                  <FontIcon Glyph="{Binding Converter={StaticResource NavGlyph}}"
                            FontSize="16"
                            Foreground="{StaticResource Brush.TextSecondary}" />
                  <TextBlock Text="{Binding Title}"
                             Foreground="{StaticResource Brush.Text}"
                             Margin="12,0,0,0"
                             VerticalAlignment="Center" />
                </StackPanel>
              </DataTemplate>
            </ListView.ItemTemplate>
          </ListView>

          <Border Grid.Row="2"
                  BorderBrush="{StaticResource Brush.Divider}"
                  BorderThickness="0,1,0,0"
                  Padding="20,12">
            <TextBlock Text="{Binding Shell.OfflineNotice}"
                       Foreground="{StaticResource Brush.TextSecondary}"
                       FontSize="11"
                       TextWrapping="Wrap" />
          </Border>
        </Grid>
      </Border>

      <ContentControl x:Name="ContentHost" Grid.Column="1" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
    </Grid>

    <!-- Toast -->
    <InfoBar x:Name="ToastBar"
             Grid.Row="1"
             VerticalAlignment="Bottom"
             HorizontalAlignment="Center"
             Margin="0,0,0,18"
             MaxWidth="560"
             IsClosable="True"
             IsOpen="False" />

  </Grid>

</Window>
