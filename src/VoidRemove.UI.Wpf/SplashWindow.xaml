<Window x:Class="VoidRemove.UI.Wpf.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VoidRemove"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        Topmost="True"
        FlowDirection="LeftToRight">

  <Border CornerRadius="16"
          Background="{DynamicResource Brush.Window}"
          BorderBrush="{DynamicResource Brush.Border}"
          BorderThickness="1"
          Padding="30,26"
          Width="380">
    <Border.Effect>
      <DropShadowEffect BlurRadius="28" ShadowDepth="0" Opacity="0.55" Color="#000000" />
    </Border.Effect>

    <StackPanel>

      <Image Source="Assets/icon-256.png"
             Width="68"
             Height="68"
             HorizontalAlignment="Center"
             RenderOptions.BitmapScalingMode="HighQuality" />

      <TextBlock Text="VoidRemove"
                 Style="{StaticResource Text.Title}"
                 FontSize="26"
                 HorizontalAlignment="Center"
                 Margin="0,14,0,2" />

      <TextBlock x:Name="TaglineText"
                 Style="{StaticResource Text.Hint}"
                 TextAlignment="Center"
                 HorizontalAlignment="Center"
                 MaxWidth="300"
                 Margin="0,0,0,18" />

      <ProgressBar IsIndeterminate="True"
                   Height="3"
                   BorderThickness="0"
                   Background="{DynamicResource Brush.Divider}"
                   Foreground="{DynamicResource Brush.Accent}" />

    </StackPanel>
  </Border>

</Window>
