<UserControl x:Class="VoidRemove.UI.Wpf.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:icons="clr-namespace:VoidRemove.Shared.Icons;assembly=VoidRemove.Shared"
             mc:Ignorable="d"
             d:DesignWidth="900"
             FlowDirection="LeftToRight">

  <UserControl.Resources>
    <Style x:Key="Row.Label" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}" />

    <Style x:Key="Row.Check" TargetType="CheckBox" BasedOn="{StaticResource Input.CheckBox}">
      <Setter Property="Margin" Value="0,0,0,10" />
    </Style>

    <!-- A label above a control, the repeating unit of this page. -->
    <Style x:Key="Field" TargetType="StackPanel">
      <Setter Property="Margin" Value="0,0,0,16" />
    </Style>
  </UserControl.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="28,22,28,10" MaxWidth="920" HorizontalAlignment="Left">

        <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Title}" />
        <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Text.Hint}" Margin="0,0,0,18" />

        <!-- ================================================= Appearance -->
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Text="{Binding AppearanceGroupTitle}" Style="{StaticResource Text.SectionHeader}" />

            <StackPanel Style="{StaticResource Field}">
              <TextBlock Text="{Binding LanguageLabel}" Style="{StaticResource Row.Label}" />
              <ComboBox Style="{StaticResource Input.ComboBox}"
                        ItemsSource="{Binding Languages}"
                        DisplayMemberPath="NativeName"
                        SelectedValuePath="Code"
                        SelectedValue="{Binding Language, Mode=TwoWay}" />
              <TextBlock Text="{Binding LanguageHint}" Style="{StaticResource Text.Hint}" />
            </StackPanel>

            <StackPanel Style="{StaticResource Field}">
              <TextBlock Text="{Binding ThemeLabel}" Style="{StaticResource Row.Label}" />
              <ComboBox Style="{StaticResource Input.ComboBox}"
                        ItemsSource="{Binding ThemeOptions}"
                        DisplayMemberPath="Display"
                        SelectedValuePath="Value"
                        SelectedValue="{Binding Theme, Mode=TwoWay}" />
            </StackPanel>

            <StackPanel Style="{StaticResource Field}">
              <TextBlock Text="{Binding AccentLabel}" Style="{StaticResource Row.Label}" />
              <StackPanel Orientation="Horizontal">
                <TextBox Style="{StaticResource Input.TextBox}"
                         Width="150"
                         Text="{Binding AccentColor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <ItemsControl ItemsSource="{Binding AccentPresets}" Margin="14,0,0,0" VerticalAlignment="Center">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <WrapPanel />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Button Width="24"
                              Height="24"
                              Margin="0,0,7,0"
                              Cursor="Hand"
                              Background="{Binding}"
                              BorderBrush="{DynamicResource Brush.Border}"
                              BorderThickness="1"
                              Command="{Binding DataContext.SetAccentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                              CommandParameter="{Binding}">
                        <Button.Template>
                          <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="7" />
                          </ControlTemplate>
                        </Button.Template>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </StackPanel>

            <StackPanel Style="{StaticResource Field}" Margin="0">
              <TextBlock Text="{Binding LayoutLabel}" Style="{StaticResource Row.Label}" />
              <ComboBox Style="{StaticResource Input.ComboBox}"
                        ItemsSource="{Binding LayoutOptions}"
                        DisplayMemberPath="Display"
                        SelectedValuePath="Value"
                        SelectedValue="{Binding Layout, Mode=TwoWay}" />
            </StackPanel>
          </StackPanel>
        </Border>

        <!-- ================================================= Uninstall -->
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Text="{Binding UninstallGroupTitle}" Style="{StaticResource Text.SectionHeader}" />

            <StackPanel Style="{StaticResource Field}">
              <TextBlock Text="{Binding UninstallBehaviorLabel}" Style="{StaticResource Row.Label}" />
              <ComboBox Style="{StaticResource Input.ComboBox}"
                        ItemsSource="{Binding BehaviorOptions}"
                        DisplayMemberPath="Display"
                        SelectedValuePath="Value"
                        SelectedValue="{Binding DefaultUninstallBehavior, Mode=TwoWay}" />
            </StackPanel>

            <StackPanel Style="{StaticResource Field}">
              <TextBlock Text="{Binding SafetyCeilingLabel}" Style="{StaticResource Row.Label}" />
              <ComboBox Style="{StaticResource Input.ComboBox}"
                        ItemsSource="{Binding SafetyOptions}"
                        DisplayMemberPath="Display"
                        SelectedValuePath="Value"
                        SelectedValue="{Binding ResidualSafetyCeiling, Mode=TwoWay}" />
            </StackPanel>

            <CheckBox Style="{StaticResource Row.Check}" Content="{Binding CreateRestorePointLabel}" IsChecked="{Binding CreateRestorePointByDefault, Mode=TwoWay}" />
            <CheckBox Style="{StaticResource Row.Check}" Content="{Binding RemoveResidualsLabel}" IsChecked="{Binding RemoveResidualsByDefault, Mode=TwoWay}" />
            <CheckBox Style="{StaticResource Row.Check}" Content="{Binding ConfirmBeforeUninstallLabel}" IsChecked="{Binding ConfirmBeforeUninstall, Mode=TwoWay}" />
            <CheckBox Style="{StaticResource Row.Check}" Content="{Binding DryRunDefaultLabel}" IsChecked="{Binding DryRunByDefault, Mode=TwoWay}" Margin="0" />
          </StackPanel>
        </Border>

        <!-- ================================================= Monitoring -->
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Text="{Binding MonitoringGroupTitle}" Style="{StaticResource Text.SectionHeader}" />

            <CheckBox Style="{StaticResource Row.Check}" Content="{Binding AutoMonitorLabel}" IsChecked="{Binding AutoMonitorEnabled, Mode=TwoWay}" />
            <TextBlock Text="{Binding AutoMonitorHint}" Style="{StaticResource Text.Hint}" Margin="0,-4,0,14" />

            <CheckBox Style="{StaticResource Row.Check}" Content="{Binding ContextMenuLabel}" IsChecked="{Binding ExplorerContextMenuEnabled, Mode=TwoWay}" />
            <TextBlock Text="{Binding ContextMenuHint}" Style="{StaticResource Text.Hint}" Margin="0,-4,0,0" />
            <TextBlock Text="{Binding NeedsRestartText}" Style="{StaticResource Text.Hint}" />
          </StackPanel>
        </Border>

        <!-- ================================================= Online -->
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Text="{Binding OnlineGroupTitle}" Style="{StaticResource Text.SectionHeader}" />

            <CheckBox Style="{StaticResource Row.Check}" Content="{Binding CheckForUpdatesLabel}" IsChecked="{Binding CheckForUpdatesEnabled, Mode=TwoWay}" />
            <TextBlock Text="{Binding CheckForUpdatesHint}" Style="{StaticResource Text.Hint}" Margin="0,-4,0,14" />

            <CheckBox Style="{StaticResource Row.Check}" Content="{Binding VirusTotalLabel}" IsChecked="{Binding VirusTotalEnabled, Mode=TwoWay}" />
            <TextBlock Text="{Binding VirusTotalHint}" Style="{StaticResource Text.Hint}" Margin="0,-4,0,12" />

            <StackPanel Style="{StaticResource Field}" Margin="0">
              <TextBlock Text="{Binding VirusTotalKeyLabel}" Style="{StaticResource Row.Label}" />
              <TextBox Style="{StaticResource Input.TextBox}"
                       MaxWidth="420"
                       HorizontalAlignment="Left"
                       IsEnabled="{Binding VirusTotalEnabled}"
                       Text="{Binding VirusTotalApiKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
              <TextBlock Text="{Binding VirusTotalKeyHint}" Style="{StaticResource Text.Hint}" />
            </StackPanel>
          </StackPanel>
        </Border>

        <!-- ================================================= Storage -->
        <Border Style="{StaticResource Card}" Margin="0">
          <StackPanel>
            <TextBlock Text="{Binding StorageGroupTitle}" Style="{StaticResource Text.SectionHeader}" />

            <StackPanel Style="{StaticResource Field}">
              <TextBlock Text="{Binding QuarantinePathLabel}" Style="{StaticResource Row.Label}" />
              <TextBox Style="{StaticResource Input.TextBox}"
                       MaxWidth="520"
                       HorizontalAlignment="Left"
                       Text="{Binding QuarantinePath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
              <StackPanel Style="{StaticResource Field}" Margin="0,0,26,0">
                <TextBlock Text="{Binding QuarantineRetentionLabel}" Style="{StaticResource Row.Label}" />
                <TextBox Style="{StaticResource Input.TextBox}"
                         Width="90"
                         Text="{Binding QuarantineRetentionDays, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
              </StackPanel>

              <StackPanel Style="{StaticResource Field}" Margin="0">
                <TextBlock Text="{Binding MaxConcurrentScansLabel}" Style="{StaticResource Row.Label}" />
                <TextBox Style="{StaticResource Input.TextBox}"
                         Width="90"
                         Text="{Binding MaxConcurrentScans, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
              </StackPanel>
            </StackPanel>
          </StackPanel>
        </Border>

      </StackPanel>
    </ScrollViewer>

    <!-- ================================================= Footer -->
    <Border Grid.Row="1"
            Background="{DynamicResource Brush.Sidebar}"
            BorderBrush="{DynamicResource Brush.Divider}"
            BorderThickness="0,1,0,0"
            Padding="28,14">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel VerticalAlignment="Center">
          <ItemsControl ItemsSource="{Binding ValidationErrors}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                  <Path Data="{x:Static icons:IconGeometry.Warning}"
                        Stroke="{DynamicResource Brush.Danger}"
                        StrokeThickness="1.5"
                        Width="14"
                        Height="14"
                        Stretch="Uniform"
                        Margin="0,0,8,0" />
                  <TextBlock Text="{Binding}"
                             Style="{StaticResource Text.Base}"
                             Foreground="{DynamicResource Brush.Danger}" />
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <TextBlock>
            <TextBlock.Style>
              <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Hint}">
                <Setter Property="Text" Value="{Binding UnsavedChangesText}" />
                <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding HasUnsavedChanges}" Value="False">
                    <Setter Property="Text" Value="" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
        </StackPanel>

        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <Button Style="{StaticResource Button.Ghost}"
                  Content="{Binding RestoreDefaultsText}"
                  Command="{Binding RestoreDefaultsCommand}"
                  Margin="0,0,10,0" />
          <Button Style="{StaticResource Button.Primary}"
                  Content="{Binding SaveText}"
                  Command="{Binding SaveCommand}"
                  MinWidth="140" />
        </StackPanel>
      </Grid>
    </Border>

  </Grid>

</UserControl>
