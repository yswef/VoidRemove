<UserControl x:Class="VoidRemove.UI.Wpf.Views.ActionCenterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Margin="28">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0" Orientation="Horizontal">
      <TextBlock Style="{StaticResource Text.Title}" Text="{Binding Title}" />
      <Button Style="{StaticResource Button.Ghost}" Content="⟳" Command="{Binding RefreshCommand}" Margin="18,0,0,0" />
      <Button Style="{StaticResource Button.Ghost}" Content="Dismiss" Command="{Binding DismissSelectedCommand}" Margin="8,0,0,0" />
      <Button Style="{StaticResource Button.Primary}" Content="Fix all" Command="{Binding FixAllCommand}" Margin="8,0,0,0" />
    </StackPanel>

    <ListView Grid.Row="1" ItemsSource="{Binding Recommendations}" SelectedItem="{Binding SelectedItem}"
              Background="Transparent" BorderThickness="0" Margin="0,12,0,0">
      <ListView.ItemTemplate>
        <DataTemplate>
          <Border Style="{StaticResource Card}" Margin="0,0,0,8" Padding="12">
            <TextBlock Text="{Binding Text}" TextWrapping="Wrap" />
          </Border>
        </DataTemplate>
      </ListView.ItemTemplate>
    </ListView>
  </Grid>
</UserControl>
