<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

  <!--
    Default palette (the Dark theme). WpfThemeApplier overwrites every key below at
    startup and whenever the theme or the accent changes, so the values here only exist
    to avoid a flash of unstyled chrome before that happens.
  -->

  <FontFamily x:Key="Font.Family">Segoe UI, Segoe UI Variable Text, Tahoma, Arial</FontFamily>
  <sys:Double x:Key="Font.Size.Small">12</sys:Double>
  <sys:Double x:Key="Font.Size.Normal">13.5</sys:Double>
  <sys:Double x:Key="Font.Size.Large">17</sys:Double>
  <sys:Double x:Key="Font.Size.Title">22</sys:Double>

  <SolidColorBrush x:Key="Brush.Window" Color="#FF0B0E14" />
  <SolidColorBrush x:Key="Brush.Sidebar" Color="#FF090C11" />
  <SolidColorBrush x:Key="Brush.TitleBar" Color="#FF0B0E14" />
  <SolidColorBrush x:Key="Brush.Card" Color="#FF121722" />
  <SolidColorBrush x:Key="Brush.Elevated" Color="#FF171D2A" />
  <SolidColorBrush x:Key="Brush.Input" Color="#FF0F1420" />
  <SolidColorBrush x:Key="Brush.ControlHover" Color="#FF1A3239" />
  <SolidColorBrush x:Key="Brush.ControlPressed" Color="#FF1C4346" />
  <SolidColorBrush x:Key="Brush.Selection" Color="#222EE6A8" />
  <SolidColorBrush x:Key="Brush.Border" Color="#FF232B3B" />
  <SolidColorBrush x:Key="Brush.Divider" Color="#FF1A2130" />
  <SolidColorBrush x:Key="Brush.Text" Color="#FFE8ECF4" />
  <SolidColorBrush x:Key="Brush.TextSecondary" Color="#FF98A2B8" />
  <SolidColorBrush x:Key="Brush.TextDisabled" Color="#FF5B6478" />
  <SolidColorBrush x:Key="Brush.Accent" Color="#FF2EE6A8" />
  <SolidColorBrush x:Key="Brush.AccentHover" Color="#FF5CEBBC" />
  <SolidColorBrush x:Key="Brush.AccentPressed" Color="#FF25BF8C" />
  <SolidColorBrush x:Key="Brush.AccentForeground" Color="#FF06120D" />
  <SolidColorBrush x:Key="Brush.Success" Color="#FF35D07F" />
  <SolidColorBrush x:Key="Brush.Warning" Color="#FFF5B840" />
  <SolidColorBrush x:Key="Brush.Danger" Color="#FFFF5470" />
  <SolidColorBrush x:Key="Brush.Info" Color="#FF4CC2FF" />
  <SolidColorBrush x:Key="Brush.Overlay" Color="#8C000000" />
  <SolidColorBrush x:Key="Brush.Transparent" Color="#00FFFFFF" />

  <sys:Double x:Key="Radius.Corner">10</sys:Double>
  <CornerRadius x:Key="CornerRadius.Card">10</CornerRadius>
  <CornerRadius x:Key="CornerRadius.Control">8</CornerRadius>
  <sys:Double x:Key="Metric.SidebarWidth">236</sys:Double>
  <sys:Double x:Key="Metric.TitleBarHeight">40</sys:Double>

</ResourceDictionary>
